{
  "manifest_version": 3,
  "name": "Fahrzeug-Mängel-Scanner",
  "short_name": "Mängel-Scanner",
  "version": "1.0.0",
  "description": "Findet auf Fahrzeugseiten automatisch Fahrzeug-PDF und Zustandsbericht, liest sie aus und listet alle Mängel per KI (OpenRouter).",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "offscreen",
    "scripting",
    "activeTab",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/content/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "options_page": "src/options/options.html",
  "action": {
    "default_title": "Fahrzeug-Mängel-Scanner",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/content/panel.css",
        "icons/*"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
