{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": false,
    "types": ["chrome", "node"],
    "baseUrl": ".",
    "paths": { "@/*": ["extension/src/*"] }
  },
  "include": ["extension/src/**/*.ts", "extension/src/**/*.tsx", "extension/src/**/*.d.ts", "vite.config.ts"]
}
